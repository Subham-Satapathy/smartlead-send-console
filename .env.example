# Base URL of the real Smartlead sending-system API.
# Leave unset (or set VITE_USE_MOCK=true) to run entirely against the
# built-in in-browser mock backend (MSW) — no real backend required.
VITE_API_BASE_URL=

# Force the mock backend even if VITE_API_BASE_URL is set.
# Defaults to "true" when VITE_API_BASE_URL is empty.
VITE_USE_MOCK=
